{
  "name": "hivenet-desktop",
  "productName": "HiveNet",
  "version": "1.0.0",
  "description": "HiveNet — Distributed Edge Cloud Storage Standalone Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -r \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron ."
  },
  "keywords": [
    "edge-storage",
    "distributed",
    "p2p",
    "electron",
    "desktop-app"
  ],
  "author": "HiveNet Team",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}